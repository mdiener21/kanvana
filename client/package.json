{
  "name": "kanvana",
  "version": "3.1.7",
  "type": "module",
  "description": "A local-first personal + AI Agent kanban board for task project people anything management.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:generate": "gh workflow run release.yml",
    "release:publish": "gh workflow run publish-release.yml",
    "test": "npm run test:unit && npm run test:dom && npm run test:e2e && npm run test:pwa",
    "test:unit": "vitest run --config vitest.config.js",
    "test:dom": "vitest run --config vitest.dom.config.js",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config playwright.performance.config.js",
    "test:perf:smoke": "playwright test --config playwright.performance.config.js --grep 'smoke:'",
    "test:e2e:live": "playwright test --config playwright.live.config.js",
    "test:pwa": "playwright test --config playwright.pwa.config.js",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:overview": "node scripts/generate-test-overview.mjs",
    "check:spec-sync": "node scripts/check-spec-sync.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "idb": "^8.0.3",
    "lucide": "^0.469.0",
    "pocketbase": "^0.26.9",
    "sortablejs": "^1.15.6"
  }
}
